import "../../heng/heng.heng";

fn main() {
    let tape=ag_tape();
    let model=nn_sequential();
    let convolution=nn_conv2d(tape,1,1,1,1,1,0,false);
    nn_init_constant(tape,convolution.parameters[0],2.0);
    let linear=nn_linear(tape,4,1,true);
    nn_init_constant(tape,linear.parameters[0],1.0);
    nn_add(model,convolution);
    nn_add(model,nn_relu());
    nn_add(model,nn_avg_pool2d(2,2,2,0));
    nn_add(model,nn_flatten(1,-1));
    nn_add(model,linear);
    let data=reshape(add(arange(16),ones([16])),[1,1,4,4]);
    let input=ag_variable(tape,data,true);
    let output=nn_forward(tape,model,input);
    assert_close(ag_value(tape,output),full([1,1],68.0),0.000000001,0.000000001);
    ag_backward(tape,ag_sum_all(tape,output),ones([]),false);
    assert_close(ag_grad(tape,input),full([1,1,4,4],0.5),0.000000001,0.000000001);
    assert_close(ag_grad(tape,convolution.parameters[0]),full([1,1,1,1],34.0),0.000000001,0.000000001);
    assert_close(ag_grad(tape,linear.parameters[0]),tensor([7.0,11.0,23.0,27.0],[4,1]),0.000000001,0.000000001);
    nn_clear_graph(tape,model);
    let fresh=ag_constant(tape,data);
    let second=nn_forward(tape,model,fresh);
    assert_close(ag_value(tape,second),full([1,1],68.0),0.000000001,0.000000001);
    let normalization_input=ag_variable(tape,tensor([1.0,2.0],[1,2]),true);
    assert(nn_forward(tape,nn_identity(),normalization_input)==normalization_input,"Identity 必须保持节点");
    let probabilities=nn_forward(tape,nn_softmax(-1),normalization_input);
    assert_close(ag_value(tape,probabilities),softmax(ag_value(tape,normalization_input),1),0.000000001,0.000000001);
    let logs=nn_forward(tape,nn_log_softmax(-1),normalization_input);
    assert_close(ag_value(tape,logs),log(softmax(ag_value(tape,normalization_input),1)),0.000000001,0.000000001);
    ag_backward(tape,ag_sum_all(tape,logs),ones([]),false);
    assert_close(ag_grad(tape,normalization_input),sub(ones([1,2]),scale(softmax(ag_value(tape,normalization_input),1),2.0)),0.000000001,0.000000001);
    let metadata:List<i64>=[2];
    let reshaped=ag_reshape(tape,normalization_input,metadata);
    ag_backward(tape,ag_sum_all(tape,reshaped),ones([]),false);
    assert(len(metadata)==1 && metadata[0]==2,"计算图释放不能修改调用者的形状列表");
    print("PASS: 卷积模块组合、Flatten、参数保留清图和元数据隔离");
}
